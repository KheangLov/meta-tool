# Required in production: protects the editor and API
NUXT_ADMIN_TOKEN=change-me-to-a-long-random-string

# Publishing (no database): fine-grained GitHub token with Contents: Read and write on this repo
NUXT_GITHUB_TOKEN=
NUXT_GITHUB_REPO=KheangLov/meta-tool
# NUXT_GITHUB_BRANCH=published-data

# Telegram user account for the built-in @WebpageBot refresh (run: npm run telegram:login)
# NUXT_TELEGRAM_API_ID=
# NUXT_TELEGRAM_API_HASH=
# NUXT_TELEGRAM_SESSION=

# Optional: image uploads to a public Vercel Blob store instead of GitHub
# BLOB_READ_WRITE_TOKEN=

# Optional Telegram bot (from @BotFather) for posting to channels/groups
# NUXT_TELEGRAM_BOT_TOKEN=

# Facebook & Messenger re-scrape (developers.facebook.com → your app → Settings → Basic)
# NUXT_FACEBOOK_APP_ID=
# NUXT_FACEBOOK_APP_SECRET=
# Optional: publish to a Facebook Page
# NUXT_FACEBOOK_PAGE_ID=
# NUXT_FACEBOOK_PAGE_TOKEN=
